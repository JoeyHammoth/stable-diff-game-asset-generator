{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "${style.checkpoint}"
    }
  },
  "2": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "clip": [
        "1",
        1
      ],
      "lora_name": "${style.loras[0].name}",
      "strength_model": "${style.loras[0].strength_model}",
      "strength_clip": "${style.loras[0].strength_clip}"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        1
      ],
      "text": "${positive}"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        1
      ],
      "text": "${negative}"
    }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "positive": [
        "10",
        0
      ],
      "negative": [
        "10",
        1
      ],
      "latent_image": [
        "5",
        0
      ],
      "seed": "${seed}",
      "steps": "${params.steps}",
      "cfg": "${params.cfg}",
      "sampler_name": "${params.sampler}",
      "scheduler": "${params.scheduler}",
      "denoise": "${params.denoise}"
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "6",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "7",
        0
      ],
      "filename_prefix": "${filename_prefix}"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "${width}",
      "height": "${height}",
      "batch_size": 1
    }
  },
  "8": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "${refs.pose.handle}"
    }
  },
  "9": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "${params.controlnet}"
    }
  },
  "10": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": [
        "3",
        0
      ],
      "negative": [
        "4",
        0
      ],
      "control_net": [
        "9",
        0
      ],
      "image": [
        "8",
        0
      ],
      "strength": "${params.controlnet_strength}",
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  }
}
